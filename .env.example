# Copy to .env (cp .env.example .env). Both apps read this single root file.

# ── Database ──────────────────────────────────────────────
# Default matches docker-compose.yml (Postgres 16 on host port 5433,
# chosen so it doesn't clash with a locally installed Postgres on 5432).
# Using a locally installed Postgres 15+ instead? Run `npm run db:setup-local`
# (see scripts/setup-local-db.mjs) and change 5433 → 5432 below.
DATABASE_URL=postgres://pm:pm@localhost:5433/pm
TEST_DATABASE_URL=postgres://pm:pm@localhost:5433/pm_test

# ── API (apps/api) ────────────────────────────────────────
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Auth ──────────────────────────────────────────────────
# Secret for signing access tokens (HS256). At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ── Web (apps/web) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
